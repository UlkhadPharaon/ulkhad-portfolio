{
  "name": "ulkhad-pharaon-portfolio",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run build",
    "pages:dev": "wrangler pages dev out",
    "deploy": "npm run build && node scripts/sync-functions.mjs && wrangler pages deploy out --project-name=ulkhad-portfolio --branch=main --commit-dirty=true"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "clsx": "2.1.1",
    "gsap": "3.15.1",
    "lenis": "1.3.27",
    "lucide-react": "1.69.0",
    "next": "16.4.5",
    "next-intl": "4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.25.0",
    "eslint-config-next": "16.4.5",
    "prettier": "^3.5.3",
    "tailwindcss": "4.3.4",
    "typescript": "^5.8.3",
    "wrangler": "^4.160.1"
  }
}
